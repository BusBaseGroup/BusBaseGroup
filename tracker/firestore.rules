rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // Signed-in users can submit an edit for themselves. Only admins can
    // approve/reject or otherwise modify an existing suggestion.
    match /suggestions/{suggestionId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.vehicleId is string
        && request.resource.data.status == 'pending';

      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow update, delete: if isAdmin();
    }

    // Public read lets every visitor see the previous-journey traces. A
    // signed-in visitor may contribute GPS points, but can only create/update
    // documents carrying their own reporter UID.
    match /journeyHistory/{vehicleId}/points/{pointId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid;

      allow update: if signedIn()
        && resource.data.reporterUid == request.auth.uid
        && request.resource.data.reporterUid == request.auth.uid;

      allow delete: if isAdmin();
    }
  }
}
